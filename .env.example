APP_HOST=0.0.0.0
APP_PORT=8080
APP_TIMEZONE=Asia/Kuala_Lumpur
LOG_LEVEL=INFO

POSTGRES_DB=cicdanalysis
POSTGRES_USER=cicdanalysis
POSTGRES_PASSWORD=replace-with-a-strong-password

JENKINS_URL=https://ugjekins.ugmid888.com
JENKINS_USER=cicd-analysis
JENKINS_API_TOKEN=
JENKINS_VERIFY_TLS=true
JENKINS_POLL_SECONDS=60
JENKINS_INITIAL_BUILD_LIMIT=20
JENKINS_CONSOLE_MAX_BYTES=524288
JENKINS_CONSOLE_HEAD_BYTES=65536
JENKINS_SERVICE_USERS=ugadmin,cicd-analysis,anonymous

TELEGRAM_BOT_TOKEN=
TELEGRAM_LISTEN_GROUP_MESSAGES=true
# 群内 /analyze 命令（需要本 Bot 的 getUpdates，Bot 不能设置 webhook）
TELEGRAM_COMMANDS=true
TELEGRAM_POLL_TIMEOUT=30
# 可选：用真人 Telegram 账号读取三个发布群（发布机器人消息 Bot 收不到）。
# API ID/HASH 在 https://my.telegram.org -> API development tools 申请；登录见 README。
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_SESSION=/data/telegram-user
TELEGRAM_USER_TRUSTED_SENDERS=ugopsbot,uguatdeploybot,ugprodopsbot
# 服务启动时自动回放最近 N 天群消息（补停机期间的消息），0 关闭
TELEGRAM_USER_BACKFILL_DAYS=2
TELEGRAM_TESTA_CHAT_ID=-1003919548725
TELEGRAM_UAT_CHAT_ID=-5592801576
TELEGRAM_PROD_CHAT_ID=-1003412281586
TELEGRAM_MANAGEMENT_CHAT_ID=
TELEGRAM_NOTIFY_FAILURES=true
# 失败构建结束后 N 分钟内首次被发现即自动分析并推送到发布群（更早的历史构建只入库不推送）
FAILURE_NOTIFY_MAX_AGE_MINUTES=180
# 取消（ABORTED）的构建是否也推送分析
TELEGRAM_NOTIFY_ABORTED=false
# “❌ Jenkins 发布通知”到达时 Jenkins 常仍在运行：每 N 秒重查一次，直到结束（最多 M 分钟）
FOLLOW_UP_SECONDS=15
FOLLOW_UP_MAX_MINUTES=60

# 可选：大模型根因分析（OpenAI 兼容接口，默认 DeepSeek）。LLM_API_KEY 为空则只用规则分析。
# 也兼容 AI_API_KEY / AI_BASE_URL / AI_MODEL / AI_MAX_TOKENS 这组名字（LLM_* 优先）。
# 日志发送前会脱敏（token/password/Bearer/URL 内凭据/私钥等），但仍会包含内部主机名、服务名等信息。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1200
LLM_MAX_INPUT_CHARS=16000
# 同一错误指纹在该小时数内复用上次的大模型结论，避免重复计费
LLM_REUSE_HOURS=24

WEBHOOK_SECRET=replace-with-a-long-random-secret
TRIGGER_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
REPORT_DAILY_HOUR=9
REPORT_DAILY_MINUTE=0
REPORT_WEEKLY_WEEKDAY=0
REPORT_MONTHLY_DAY=1
